@echo off
chcp 65001 >nul
title 实验室助手 - 同步云端
echo ============================================
echo   实验室助手 - 同步到云端（Gitee 私有仓库）
echo ============================================
echo.
cd /d %~dp0
git push
if errorlevel 1 (
    echo.
    echo 同步失败。常见原因：
    echo   1. 网络不通（校园网波动，换个时间再试）
    echo   2. 云端仓库还没配置好（请把本窗口内容截图发给 Claude 处理）
    pause
    exit /b 1
)
echo.
echo ============================================
echo   ✓ 已同步到云端！代码已有双重保险。
echo ============================================
pause
